APP_NAME=Vefiri
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CURRENCY=NGN
PAYSTACK_TIMEOUT=30
PAYSTACK_CALLBACK_URL="${APP_URL}/checkout/callback"
PAYSTACK_PREMIUM_CALLBACK_URL="${APP_URL}/vendor/premium/callback"

# Tax rate as a percentage. Set to false to calculate tax before discounts.
CHECKOUT_TAX_RATE=7.5
CHECKOUT_TAX_AFTER_DISCOUNT=true
# Shipping fee in kobo. 0 = free delivery.
CHECKOUT_SHIPPING_FEE=0

VENDOR_FREE_PRODUCT_LIMIT=10
# Leave blank for unlimited premium products.
VENDOR_PREMIUM_PRODUCT_LIMIT=
# Stored in kobo: 500000 = NGN 5,000.
VENDOR_PREMIUM_PRICE=500000
VENDOR_PREMIUM_CURRENCY=NGN
# Set to 0 for a non-expiring premium entitlement.
VENDOR_PREMIUM_DURATION_DAYS=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Use "s3" or another persistent disk in production so uploads survive deploys.
PRODUCT_IMAGES_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@vefiri.com"
MAIL_FROM_NAME="${APP_NAME}"
VEFIRI_SUPPORT_EMAIL="support@vefiri.com"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=
ADMIN_PASSWORD=
